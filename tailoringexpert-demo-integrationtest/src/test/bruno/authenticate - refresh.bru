meta {
  name: authenticate - refresh
  type: http
  seq: 4
}

post {
  url: {{HOST}}{{auth.refresh}}
  body: json
  auth: inherit
}

body:json {
  {
    "userId": "{{USER}}",
    "refreshToken": "{{auth.refresh_token}}"
  }
}

script:post-response {
  let data = res.body;
  
  const auth = bru.getVar("auth");
  
  auth.accessToken = data.accessToken;
  auth.refreshToken = data.refreshToken;
  auth.refresh = data.links[0].href;
  
  bru.setVar("auth",  auth);
  
}
